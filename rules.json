{
  "$schema": "公众号纠错规则 v1",
  "version": "2026-05-27",
  "rules": [
    {
      "id": "iphone-format",
      "group": "老板特殊规定 🔧",
      "name": "iPhone 写法规范",
      "desc": "正确写法是 iPhone 17 Pro（i 小写、P 大写、有空格）。同样适用 iPad / iMac / iOS / macOS。",
      "level": "danger",
      "enabled": true,
      "type": "builtin",
      "builtin": "iphone-format"
    },
    {
      "id": "cn-number",
      "group": "老板特殊规定 🔧",
      "name": "中文数字应改为阿拉伯数字",
      "desc": "一二三 + 量词（个/次/天/分钟…）应改阿拉伯数字。成语、专有名词会误报，请人工判断。",
      "level": "warn",
      "enabled": true,
      "type": "builtin",
      "builtin": "cn-number"
    },
    {
      "id": "common-typo",
      "group": "错别字 / 病句 ✅",
      "name": "高频错别字",
      "desc": "内置常见错别字对照表。",
      "level": "danger",
      "enabled": true,
      "type": "keyword-map",
      "pairs": [
        ["再接再励", "再接再厉"],
        ["按装", "安装"],
        ["帐号", "账号"],
        ["帐户", "账户"],
        ["即然", "既然"],
        ["园满", "圆满"],
        ["迫不急待", "迫不及待"],
        ["震憾", "震撼"],
        ["一愁莫展", "一筹莫展"],
        ["不径而走", "不胫而走"],
        ["亲睐", "青睐"],
        ["名信片", "明信片"],
        ["甘败下风", "甘拜下风"],
        ["渡假", "度假"],
        ["默守成规", "墨守成规"],
        ["走头无路", "走投无路"]
      ]
    },
    {
      "id": "dup-char",
      "group": "错别字 / 病句 ✅",
      "name": "疑似重复字",
      "desc": "如「的的」「了了」「是是」等连续重复。",
      "level": "warn",
      "enabled": true,
      "type": "regex",
      "pattern": "([的了是在和与就也都])\\1",
      "flags": "g",
      "fix": "删除一个"
    },
    {
      "id": "halfwidth-punc",
      "group": "格式 / 排版 ✅",
      "name": "中文里混入半角标点",
      "desc": "中文里应使用全角标点 ，。？！：；",
      "level": "warn",
      "enabled": true,
      "type": "builtin",
      "builtin": "halfwidth-punc"
    },
    {
      "id": "dup-punc",
      "group": "格式 / 排版 ✅",
      "name": "连续重复标点",
      "desc": "如「。。」「！！」「，，」等。",
      "level": "warn",
      "enabled": true,
      "type": "regex",
      "pattern": "([，。！？；：、,.!?;:])\\1+",
      "flags": "g",
      "fix": "保留一个即可"
    },
    {
      "id": "multi-space",
      "group": "格式 / 排版 ✅",
      "name": "多余连续空格",
      "desc": "连续 2 个及以上空格。",
      "level": "info",
      "enabled": true,
      "type": "regex",
      "pattern": " {2,}",
      "flags": "g",
      "fix": "改为 1 个空格"
    },
    {
      "id": "absolute-words",
      "group": "敏感词 / 合规 ⚠️",
      "name": "广告法极限词",
      "desc": "最/第一/独家/100% 等绝对化用语可能违反广告法。",
      "level": "danger",
      "enabled": true,
      "type": "keyword-list",
      "words": ["第一", "首个", "独家", "唯一", "顶级", "国家级", "世界级", "永久", "绝对", "100%", "最佳", "最好", "最低", "最高", "根治", "治愈", "保本", "稳赚", "保过", "官方推荐"],
      "fix": "考虑换用相对化表达"
    },
    {
      "id": "link-check",
      "group": "其他提示",
      "name": "链接需复查",
      "desc": "检测到 http(s) 链接，请确认是否可点击、是否最新。",
      "level": "info",
      "enabled": true,
      "type": "regex",
      "pattern": "https?://[^\\s，。！？)]+",
      "flags": "g",
      "fix": "请确认链接有效且为最新"
    }
  ]
}
